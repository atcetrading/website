---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { industries } from '../../../data/industries';
import { productsForIndustry } from '../../../data/products';
import { languages, localizedPath, pick, useTranslations, type Lang } from '../../../i18n/utils';

export function getStaticPaths() {
  return languages.flatMap((lang) => industries.map((industry) => ({ params: { lang, slug: industry.slug }, props: { industry } })));
}

const lang = Astro.params.lang as Lang;
const { industry } = Astro.props;
const t = useTranslations(lang);
const related = productsForIndustry(industry.slug);
---

<BaseLayout
  lang={lang}
  title={pick(industry.name, lang)}
  description={pick(industry.summary, lang)}
  path={`/industries/${industry.slug}/`}
>
  <div class="mx-auto max-w-6xl px-4 pt-12">
    <a href={localizedPath(lang, '/industries/')} class="text-sm font-semibold text-brand-600 hover:underline"><span class="flip-rtl inline-block">←</span> {t('common.allIndustries')}</a>
    <h1 class="mt-3 text-3xl text-brand-800 sm:text-4xl">{pick(industry.name, lang)}</h1>
    <p class="mt-4 max-w-3xl text-lg text-brand-900/80">{pick(industry.description, lang)}</p>

    <h2 class="mt-12 mb-6 text-2xl text-brand-800">{t('common.productsFor')}</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((product) => <ProductCard product={product} lang={lang} />)}
    </div>
  </div>
</BaseLayout>
