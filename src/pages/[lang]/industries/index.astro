---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import IndustryCard from '../../../components/IndustryCard.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { industries } from '../../../data/industries';
import { langPaths, useTranslations, type Lang } from '../../../i18n/utils';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('industriesPage.title')} description={t('industriesPage.description')} path="/industries/">
  <div class="mx-auto max-w-6xl px-4 pt-12">
    <SectionHeading title={t('industriesPage.title')} intro={t('industriesPage.intro')} />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {industries.map((industry) => <IndustryCard industry={industry} lang={lang} />)}
    </div>
  </div>
</BaseLayout>
