---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langPaths, useTranslations, type Lang } from '../../i18n/utils';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// Placeholder details — replace with the company's real contact info.
const email = 'info@example.com';
const phone = '+20 000 000 0000';

const fieldClass = 'mt-1 w-full rounded-lg border border-sand-200 bg-white px-3 py-2 focus:border-brand-500 focus:outline-none';
---

<BaseLayout lang={lang} title={t('contact.title')} description={t('contact.description')} path="/contact/">
  <div class="mx-auto max-w-5xl px-4 pt-12">
    <h1 class="text-3xl text-brand-800 sm:text-4xl">{t('contact.title')}</h1>
    <p class="mt-3 text-lg text-brand-900/80">{t('contact.intro')}</p>

    <div class="mt-10 grid gap-10 md:grid-cols-5">
      <!-- TODO: connect to a form service (e.g. Formspree) once hosting is set up -->
      <form class="space-y-4 md:col-span-3" action="#" method="post">
        <label class="block text-sm font-medium">{t('contact.name')}<input class={fieldClass} type="text" name="name" required /></label>
        <label class="block text-sm font-medium">{t('contact.company')}<input class={fieldClass} type="text" name="company" /></label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-sm font-medium">{t('contact.email')}<input class={fieldClass} type="email" name="email" required /></label>
          <label class="block text-sm font-medium">{t('contact.phone')}<input class={fieldClass} type="tel" name="phone" dir="ltr" /></label>
        </div>
        <label class="block text-sm font-medium">{t('contact.message')}<textarea class={fieldClass} name="message" rows="5" required></textarea></label>
        <button type="submit" class="rounded-lg bg-brand-600 px-5 py-3 font-semibold text-white hover:bg-brand-700">{t('contact.send')}</button>
        <p class="text-xs text-brand-900/60">{t('contact.formNote')}</p>
      </form>

      <aside class="rounded-xl border border-sand-200 bg-white p-6 text-sm md:col-span-2">
        <h2 class="mb-4 text-lg text-brand-800">{t('contact.detailsTitle')}</h2>
        <dl class="space-y-3">
          <div><dt class="font-semibold">{t('contact.address')}</dt><dd>{t('contact.addressValue')}</dd></div>
          <div><dt class="font-semibold">{t('contact.phone')}</dt><dd dir="ltr" class="text-start">{phone}</dd></div>
          <div><dt class="font-semibold">{t('contact.email')}</dt><dd><a class="text-brand-600 hover:underline" href={`mailto:${email}`}>{email}</a></dd></div>
        </dl>
      </aside>
    </div>
  </div>
</BaseLayout>
