---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import IndustryCard from '../../components/IndustryCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import ApprovalBadges from '../../components/ApprovalBadges.astro';
import { industries } from '../../data/industries';
import { products } from '../../data/products';
import { langPaths, localizedPath, useTranslations, type Lang } from '../../i18n/utils';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const featured = products.filter((p) => p.featured);
---

<BaseLayout lang={lang} title={t('home.title')} description={t('home.description')} path="/">
  <section class="bg-gradient-to-b from-brand-100 to-sand-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
      <p class="mb-3 inline-block rounded-full bg-white px-3 py-1 text-xs font-semibold text-brand-700">{t('common.mainProduct')}: {t('common.salt')}</p>
      <h1 class="max-w-3xl text-4xl text-brand-800 sm:text-5xl">{t('home.heroTitle')}</h1>
      <p class="mt-5 max-w-2xl text-lg text-brand-900/80">{t('home.heroText')}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={localizedPath(lang, '/products/')} class="rounded-lg bg-brand-600 px-5 py-3 font-semibold text-white hover:bg-brand-700">{t('home.ctaProducts')}</a>
        <a href={localizedPath(lang, '/contact/')} class="rounded-lg border border-brand-600 px-5 py-3 font-semibold text-brand-700 hover:bg-white">{t('home.ctaContact')}</a>
      </div>
      <div class="mt-10"><ApprovalBadges lang={lang} /></div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-16">
    <SectionHeading title={t('home.industriesTitle')} intro={t('home.industriesIntro')} />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {industries.map((industry) => <IndustryCard industry={industry} lang={lang} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-16">
    <SectionHeading title={t('home.featuredTitle')} intro={t('home.featuredIntro')} />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((product) => <ProductCard product={product} lang={lang} />)}
    </div>
    <a href={localizedPath(lang, '/products/')} class="mt-6 inline-block font-semibold text-brand-600 hover:underline">{t('common.viewAll')} <span class="flip-rtl inline-block">→</span></a>
  </section>

  <section class="mx-auto mt-16 max-w-6xl px-4">
    <div class="rounded-2xl bg-brand-700 px-6 py-10 text-center text-white sm:px-12">
      <h2 class="text-2xl sm:text-3xl">{t('home.ctaBandTitle')}</h2>
      <p class="mx-auto mt-2 max-w-xl text-brand-100">{t('home.ctaBandText')}</p>
      <a href={localizedPath(lang, '/contact/')} class="mt-6 inline-block rounded-lg bg-accent-500 px-6 py-3 font-semibold text-brand-900 hover:bg-accent-600">{t('common.requestQuote')}</a>
    </div>
  </section>
</BaseLayout>
