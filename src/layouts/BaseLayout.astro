---
import '@fontsource-variable/inter';
import '@fontsource/cairo/400.css';
import '@fontsource/cairo/600.css';
import '@fontsource/cairo/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dir, languages, localizedPath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Page path without the language prefix, e.g. "/products/" */
  path: string;
}

const { lang, title, description, path } = Astro.props;
const t = useTranslations(lang);
const siteName = t('site.name');
const homeTitle = siteName === t('site.short') ? siteName : `${siteName} (${t('site.short')})`;
const fullTitle = path === '/' ? homeTitle : `${title} | ${t('site.short')}`;
---

<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    {/* hreflang needs absolute URLs, so it only renders once `site` is set in astro.config.mjs */}
    {Astro.site && languages.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localizedPath(l, path), Astro.site).href} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header lang={lang} path={path} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
