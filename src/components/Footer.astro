---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<footer class="mt-16 bg-brand-900 text-brand-100">
  <div class="mx-auto max-w-6xl px-4 py-8 text-sm">
    <p class="font-semibold text-white">{t('site.legalName')}</p>
    <p class="mt-1 text-brand-200">{t('site.tagline')}</p>
    <p class="mt-4 text-brand-200">© {new Date().getFullYear()} {t('site.short')}. {t('footer.rights')}</p>
  </div>
</footer>
