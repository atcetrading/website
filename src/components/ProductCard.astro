---
import type { Product } from '../data/products';
import { localizedPath, pick, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  product: Product;
  lang: Lang;
}

const { product, lang } = Astro.props;
const t = useTranslations(lang);
---

<a
  href={localizedPath(lang, `/products/${product.slug}/`)}
  class="group flex flex-col rounded-xl border border-sand-200 bg-white p-5 transition hover:border-brand-500 hover:shadow-md"
>
  <span class="mb-3 inline-flex w-fit rounded-full bg-sand-100 px-2.5 py-0.5 text-xs font-medium text-brand-700">{t('common.salt')}</span>
  <h3 class="text-lg text-brand-800">{pick(product.name, lang)}</h3>
  <p class="mt-2 flex-1 text-sm text-brand-900/80">{pick(product.summary, lang)}</p>
  <span class="mt-4 text-sm font-semibold text-brand-600 group-hover:underline">{t('common.viewDetails')} <span class="flip-rtl inline-block">→</span></span>
</a>
